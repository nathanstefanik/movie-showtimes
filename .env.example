# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Required to use any mutating endpoint (/api/refresh, /api/theaters POST/DELETE).
# The server fails closed (503) on those routes if this is unset.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# https://www.themoviedb.org/settings/api — enables posters/overviews/director
# in the day view. The app runs fine without it; that metadata is just blank.
TMDB_API_KEY=

# Checked by deploy.sh's preflight only; not read by the app itself.
OMDB_API_KEY=

# Optional: override where Letterboxd export CSVs are read from.
# Defaults to ./data/movies (searched upward from the working directory).
# LETTERBOXD_DATA_DIR=
