[Unit]
Description=Movie Showtimes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moviedash
Group=moviedash
# godotenv reads .env from WorkingDirectory (ADMIN_TOKEN, TMDB_API_KEY).
WorkingDirectory=/opt/movie-showtimes
ExecStart=/opt/movie-showtimes/movie-showtimes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
